# Bootstrap settings only. Everything else is seeded into the database on first
# init and edited from the console afterwards.

# ---------------------------------------------------------------------------
# Read by the containers (env_file). These work from the repository root.
# ---------------------------------------------------------------------------

# Generate the secret with: openssl rand -base64 48
# The process refuses to start if it is missing or shorter than 32 characters.
DTK_SECRET_KEY=Douyin_TikTok_Download_API_123456
POSTGRES_PASSWORD=123456
REDIS_PASSWORD=123456

DTK_DATABASE_URL=postgresql+asyncpg://dtk:123456@postgres:5432/dtk
DTK_REDIS_URL=redis://:123456@redis:6379/0

# Only with a reverse proxy in front.
DTK_FORWARDED_ALLOW_IPS=

DTK_LOG_LEVEL=info
DTK_LOG_JSON=true

DTK_BROWSER_RPC_URL=http://browser-rpc:9000
DTK_DOWNLOADER_URL=http://downloader:9100
DTK_DOWNLOADER_TOKEN=

DTK_DOWNLOADER_WORKERS=4
DTK_DOWNLOADER_ITEM_WORKERS=4
DTK_BROWSER_WARM_CONTEXTS=1


# ---------------------------------------------------------------------------
# BUILD AND COMPOSE - interpolated, NOT read from this file's usual location.
# Prefix the command with COMPOSE_ENV_FILES=.env, or export them.
# ---------------------------------------------------------------------------

# Where the api container publishes.
DTK_BIND_HOST=0.0.0.0
DTK_BIND_PORT=28001

# Ceiling for the redis container.
DTK_REDIS_MAXMEMORY=320mb

# Published images from Docker Hub (use latest tag per install.sh behavior).
# When these are set, compose pulls instead of building from source.
# Empty = build from local source. Set to use published images instead.
DTK_IMAGE=
DTK_IMAGE_TAG=
DTK_DOWNLOADER_IMAGE=

# Which CloakBrowser revision the browser image installs.
CLOAKBROWSER_COMMIT=f04c23da285b3b3d3cf10c8f9d282e7adc1d52ce